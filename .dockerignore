# Allowlist: the build context is only what the Containerfiles copy, so local
# artifacts (target/, coverage output, editor files) never get sent.
*

# The locked workspace. Containerfile and Containerfile.fips both build from
# all of it, and the FIPS report stage also runs xtask.
!Cargo.toml
!Cargo.lock
!crates/
!tests/
!xtask/

# The default config baked into the images.
!examples/configs/operations/container-default.yaml

# Build output and test artifacts inside the allowed directories.
**/target/
**/*.db
**/*.profraw
**/mutants.out*/
