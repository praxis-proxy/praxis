# Ignore build artifacts and generated files
target/

# Ignore documentation
.*
docs/
*.md
LICENSE*

# Ignore fmt, lint and deny configs
rustfmt.toml
deny.toml

# Ignore devtools. The test crates and xtask stay in the context: the FIPS
# build (Containerfile.fips) resolves the whole locked workspace and runs
# the compliance report with `cargo xtask fips`.
Makefile
benchmarks/

# Ignore all examples except the default container config
examples/
!examples/configs/operations/container-default.yaml
